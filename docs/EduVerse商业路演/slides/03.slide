<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', position: 'relative' }}>
  {/* A · Title */}
  <Box style={{ position: 'absolute', left: 64, top: 20 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>Our solution: one platform, three doors</Text>
    <Box style={{ width: 120, height: 4, borderRadius: 2, background: '#1D4ED8', marginTop: 10 }} />
  </Box>

  <Text style={{ position: 'absolute', left: 64, top: 108, fontSize: 17, lineHeight: 1.5, color: '#0F172A', opacity: 0.72 }}>
    Most tools serve one person. Agentic EduVerse connects the teacher, the student and the parent — in one live classroom.
  </Text>

  {/* B · Three portal cards */}
  <Box style={{ position: 'absolute', left: 64, right: 64, top: 168, flexDirection: 'row', gap: 28 }}>
    {[
      { icon: 'chalkboard-teacher', name: 'Teacher', line: 'Runs the live lesson, uploads materials, records the class.' },
      { icon: 'user-graduate', name: 'Student', line: 'Joins with a room code, learns with five AI companions, earns coins.' },
      { icon: 'users', name: 'Parent', line: 'Links through a verified invite and follows progress every week.' },
    ].map((p) => (
      <Box key={p.name} style={{ flex: 1, height: 190, background: '#F1F5F9', borderRadius: 14, padding: 26, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 46, height: 46, borderRadius: 12, background: '#1D4ED8', justifyContent: 'center', alignItems: 'center' }}>
            <FAIcon name={p.icon} style={{ fill: '#FFFFFF', width: 24, height: 24 }} />
          </Box>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F172A' }}>{p.name}</Text>
        </Box>
        <Text style={{ fontSize: 15, lineHeight: 1.5, color: '#0F172A', opacity: 0.75 }}>{p.line}</Text>
      </Box>
    ))}
  </Box>

  {/* Connectors */}
  <Box style={{ position: 'absolute', left: 0, right: 0, top: 372, flexDirection: 'row', justifyContent: 'center', gap: 320 }}>
    <FAIcon name='arrow-down' style={{ fill: '#1D4ED8', width: 26, height: 26 }} />
    <FAIcon name='arrow-down' style={{ fill: '#1D4ED8', width: 26, height: 26 }} />
    <FAIcon name='arrow-down' style={{ fill: '#1D4ED8', width: 26, height: 26 }} />
  </Box>

  {/* Central platform bar */}
  <Box style={{ position: 'absolute', left: 64, right: 64, top: 420, height: 150, borderRadius: 16, background: 'linear-gradient(135deg,#1D4ED8 0%,#06B6D4 100%)', padding: '24px 40px', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>One shared platform</Text>
    <Box style={{ flexDirection: 'row', gap: 36, alignItems: 'center' }}>
      {['Live video classroom', 'AI companions & translator', 'Learning record & reports', '8 interface languages'].map((f) => (
        <Box key={f} style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <FAIcon name='check-circle' style={{ fill: '#FFFFFF', width: 18, height: 18 }} />
          <Text style={{ fontSize: 15, color: '#FFFFFF' }}>{f}</Text>
        </Box>
      ))}
    </Box>
  </Box>

  {/* C · Footer */}
  <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 0, height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>Agentic EduVerse · Roadshow 2026</Text>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>03 / 14</Text>
  </Box>
</Slide>
