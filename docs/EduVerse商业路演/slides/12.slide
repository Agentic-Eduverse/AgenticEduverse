<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', position: 'relative' }}>
  {/* A · Title */}
  <Box style={{ position: 'absolute', left: 64, top: 20 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>A market that is already moving</Text>
    <Box style={{ width: 120, height: 4, borderRadius: 2, background: '#06B6D4', marginTop: 10 }} />
  </Box>

  {/* Left: giant anchor */}
  <Box style={{ position: 'absolute', left: 64, top: 175, width: 420, flexDirection: 'column', gap: 22 }}>
    <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#1D4ED8', lineHeight: 1 }}>
      $5.8<span style={{ fontSize: 44 }}>B</span>
    </Text>
    <Text style={{ fontSize: 19, lineHeight: 1.5, color: '#0F172A' }}>
      AI-in-education spending by 2030 — up from <span style={{ fontWeight: 'bold' }}>$2.2B in 2024</span>.
    </Text>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
      <Box style={{ paddingHorizontal: 14, paddingVertical: 8, borderRadius: 999, background: 'rgba(6,182,212,0.14)' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F172A' }}>CAGR 17.5%</Text>
      </Box>
      <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.5 }}>MarketsandMarkets, 2024</Text>
    </Box>
    <Text style={{ fontSize: 15, lineHeight: 1.55, color: '#0F172A', opacity: 0.72 }}>
      Faster views go higher: another analyst sees <span style={{ fontWeight: 'bold' }}>$34.6B by 2030</span> at 36.5% a year. Either way, the wave is real.
    </Text>
  </Box>

  {/* Right: bar chart built from boxes */}
  <Box style={{ position: 'absolute', right: 64, top: 150, width: 620, height: 430, background: '#F8FAFC', borderRadius: 16, border: '1px solid rgba(15,23,42,0.07)', padding: 30, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-around' }}>
    {[
      { y: '2023', v: 1.78, h: 92, c: '#94A3B8' },
      { y: '2024', v: 2.21, h: 116, c: '#1D4ED8' },
      { y: '2030', v: 5.82, h: 300, c: '#06B6D4' },
    ].map((b) => (
      <Box key={b.y} style={{ flexDirection: 'column', alignItems: 'center', justifyContent: 'flex-end', height: '100%', width: 140 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F172A', marginBottom: 8 }}>${b.v}B</Text>
        <Box style={{ width: 110, height: b.h, background: b.c, borderRadius: 8 }} />
        <Text style={{ fontSize: 15, color: '#0F172A', opacity: 0.65, marginTop: 10 }}>{b.y}</Text>
      </Box>
    ))}
  </Box>

  {/* C · Footer */}
  <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 0, height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>Agentic EduVerse · Roadshow 2026</Text>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>12 / 14</Text>
  </Box>
</Slide>
