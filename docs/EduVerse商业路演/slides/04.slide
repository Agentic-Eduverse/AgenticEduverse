<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', position: 'relative' }}>
  {/* A · Title */}
  <Box style={{ position: 'absolute', left: 64, top: 20 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>Teacher portal: run the whole lesson</Text>
    <Box style={{ width: 120, height: 4, borderRadius: 2, background: '#1D4ED8', marginTop: 10 }} />
  </Box>

  {/* Left: text column */}
  <Box style={{ position: 'absolute', left: 64, top: 150, width: 430, flexDirection: 'column', gap: 26 }}>
    {[
      { icon: 'plus-circle', h: 'Create a class in one minute', p: 'Every class gets a 6-character room code and an optional password.' },
      { icon: 'video', h: 'One click goes live', p: 'HD camera, microphone and screen share inside the browser.' },
      { icon: 'file-upload', h: 'Share materials instantly', p: 'Students see new files the moment they are uploaded — no refresh.' },
      { icon: 'users', h: 'Invite parents safely', p: 'A signed link valid for 24 hours, tied to one verified email.' },
    ].map((f) => (
      <Box key={f.h} style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
        <FAIcon name={f.icon} style={{ fill: '#1D4ED8', width: 26, height: 26, marginTop: 2 }} />
        <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>{f.h}</Text>
          <Text style={{ fontSize: 14, lineHeight: 1.5, color: '#0F172A', opacity: 0.68 }}>{f.p}</Text>
        </Box>
      </Box>
    ))}
  </Box>

  {/* Right: screenshot card */}
  <Box style={{ position: 'absolute', right: 64, top: 150, width: 660, background: '#F1F5F9', borderRadius: 14, padding: 14, boxShadow: '0 8px 28px rgba(15,23,42,0.14)' }}>
    <Image src='assets/teacher_en.png' style={{ width: '100%', height: 354, objectFit: 'cover', borderRadius: 8 }} />
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.55, marginTop: 10, textAlign: 'center' }}>
      Real product — class cards with room codes and a live status badge
    </Text>
  </Box>

  {/* C · Footer */}
  <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 0, height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>Agentic EduVerse · Roadshow 2026</Text>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>04 / 14</Text>
  </Box>
</Slide>
