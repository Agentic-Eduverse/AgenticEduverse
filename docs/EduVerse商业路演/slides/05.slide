<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', position: 'relative' }}>
  {/* A · Title */}
  <Box style={{ position: 'absolute', left: 64, top: 20 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>Student portal: progress you can feel</Text>
    <Box style={{ width: 120, height: 4, borderRadius: 2, background: '#1D4ED8', marginTop: 10 }} />
  </Box>

  {/* Left: screenshot card (mirrored layout vs. slide 04) */}
  <Box style={{ position: 'absolute', left: 64, top: 150, width: 660, background: '#F1F5F9', borderRadius: 14, padding: 14, boxShadow: '0 8px 28px rgba(15,23,42,0.14)' }}>
    <Image src='assets/student_en.png' style={{ width: '100%', height: 354, objectFit: 'cover', borderRadius: 8 }} />
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.55, marginTop: 10, textAlign: 'center' }}>
      Real product — weekly stats, coins and one-tap class joining
    </Text>
  </Box>

  {/* Right: text column */}
  <Box style={{ position: 'absolute', right: 64, top: 150, width: 430, flexDirection: 'column', gap: 26 }}>
    {[
      { icon: 'key', h: 'Join with a room code', p: 'Codes avoid look-alike characters (no 0, 1, I, O) and ignore letter case.' },
      { icon: 'coins', h: 'Coins for real effort', p: 'Joining a class, answering and practising all earn coins.' },
      { icon: 'chart-line', h: 'Weekly progress, made visible', p: 'Study time, answer accuracy and weak spots on one small card.' },
      { icon: 'door-open', h: 'Enter the live classroom', p: 'Students watch the teacher, join the whiteboard and raise a hand.' },
    ].map((f) => (
      <Box key={f.h} style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
        <FAIcon name={f.icon} style={{ fill: '#1D4ED8', width: 26, height: 26, marginTop: 2 }} />
        <Box style={{ flex: 1, flexDirection: 'column', gap: 5 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>{f.h}</Text>
          <Text style={{ fontSize: 14, lineHeight: 1.5, color: '#0F172A', opacity: 0.68 }}>{f.p}</Text>
        </Box>
      </Box>
    ))}
  </Box>

  {/* C · Footer */}
  <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 0, height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>Agentic EduVerse · Roadshow 2026</Text>
    <Text style={{ fontSize: 12, color: '#0F172A', opacity: 0.45 }}>05 / 14</Text>
  </Box>
</Slide>
