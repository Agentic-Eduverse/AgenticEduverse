generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  password     String?
  avatarConfig Json?
  coins        Int      @default(0)
  createdAt    DateTime @default(now())

  classes             Class[]             @relation("TeacherClasses")
  enrollments         Enrollment[]
  submissions         Submission[]
  emotionLogs         EmotionLog[]
  messages            Message[]
  agentMemories       AgentMemory[]
  parentLinks         ParentStudentLink[] @relation("ParentLinks")
  childLinks          ParentStudentLink[] @relation("ChildLinks")
  issuedParentLinks   ParentStudentLink[] @relation("IssuedParentLinks")
  issuedInvitations   ParentInvitation[]  @relation("IssuedInvitations")
  redeemedInvitations ParentInvitation[]  @relation("RedeemedInvitations")
  studentInvitations  ParentInvitation[]  @relation("InvitedStudents")
  attendances         Attendance[]
  rewards             RewardLedger[]
  whiteboardEvents    WhiteboardEvent[]
  uploadedFiles       ClassFile[]
  rolePlayMessages    RolePlayMessage[]
  teacherTutoringSessions TutoringSession[] @relation("TutoringTeacher")
  studentTutoringSessions TutoringSession[] @relation("TutoringStudent")
}

model Class {
  id          String    @id @default(cuid())
  name        String
  teacherId   String
  roomCode    String    @unique
  password    String?
  scheduledAt DateTime?
  duration    Int
  isLive      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  teacher          User                 @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  sessions         Session[]
  materials        Material[]
  quizzes          Quiz[]
  rolePlayScenarios RolePlayScenario[]
  parentInvitations ParentInvitation[]
  attendances       Attendance[]
  whiteboardEvents  WhiteboardEvent[]
  files             ClassFile[]
  recordings        Recording[]
  tutoringSessions  TutoringSession[]

  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  joinedAt  DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

model Session {
  id           String    @id @default(cuid())
  classId      String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  recordingUrl String?
  notes        String?
  analytics    Json?

  class    Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  emotions EmotionLog[]
  messages Message[]
  attendances Attendance[]
  quizzes Quiz[]
  recordings Recording[]
  tutoringSessions TutoringSession[]

  @@index([classId, endedAt])
}

model EmotionLog {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  emotion   String
  timestamp DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  content   String
  role      String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Material {
  id        String   @id @default(cuid())
  classId   String
  title     String
  content   String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, type, createdAt])
}

model Quiz {
  id        String   @id @default(cuid())
  classId   String
  title     String
  questions Json
  createdBy String
  createdAt DateTime @default(now())
  status     String   @default("DRAFT")
  source     String   @default("MANUAL")
  timeLimitSeconds Int @default(60)
  startedAt  DateTime?
  endedAt    DateTime?
  sessionId  String?

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([classId])
  @@index([sessionId, status])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  answers   Json
  score     Int?
  rawScore  Int?
  totalPoints Int?
  correctCount Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([quizId, score])
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  agentType String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentType, key])
}

model RolePlayScenario {
  id          String   @id @default(cuid())
  classId     String
  title       String
  description String
  roles       Json
  assignments Json?
  summary     String?
  status      String   @default("DRAFT")
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  messages RolePlayMessage[]

  @@index([classId, createdAt])
}

model RolePlayMessage {
  id         String   @id @default(cuid())
  scenarioId String
  userId     String
  roleName   String?
  content    String
  createdAt  DateTime @default(now())

  scenario RolePlayScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scenarioId, createdAt])
}

model Attendance {
  id        String    @id @default(cuid())
  sessionId String
  classId   String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@index([classId, joinedAt])
}

model RewardLedger {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String   @unique
  reason    String
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WhiteboardEvent {
  id        String   @id @default(cuid())
  classId   String
  userId    String
  sequence  Int
  action    String
  payload   Json
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, sequence])
  @@index([classId, createdAt])
}

model ClassFile {
  id           String   @id @default(cuid())
  classId      String
  uploadedById String
  name         String
  mimeType     String
  size         Int
  storagePath  String
  createdAt    DateTime @default(now())

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
}

model Recording {
  id        String    @id @default(cuid())
  classId   String
  sessionId String?
  status    String    @default("STARTING")
  egressId  String?
  fileUrl   String?
  whiteboardStart Json?
  publishedAt DateTime?
  startedAt DateTime  @default(now())
  // Recording runs in the teacher's browser, so the row can be orphaned by a crash, a page
  // reload or a closed tab. The client pings this while it is recording; a row whose
  // heartbeat has gone quiet is treated as dead instead of blocking every later recording.
  heartbeatAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([classId, createdAt])
}

model TutoringSession {
  id        String    @id @default(cuid())
  classId   String
  sessionId String?
  teacherId String
  studentId String
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  teacher User     @relation("TutoringTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User     @relation("TutoringStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, status])
  @@index([studentId, status])
  @@index([teacherId, status])
}

model ParentInvitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  teacherId   String
  studentId   String
  classId     String
  parentEmail String
  expiresAt   DateTime
  redeemedAt  DateTime?
  redeemedBy  String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  teacher       User  @relation("IssuedInvitations", fields: [teacherId], references: [id], onDelete: Cascade)
  student       User  @relation("InvitedStudents", fields: [studentId], references: [id], onDelete: Cascade)
  redeemedByUser User? @relation("RedeemedInvitations", fields: [redeemedBy], references: [id], onDelete: SetNull)
  class         Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  link          ParentStudentLink?

  @@index([teacherId, classId, createdAt])
}

model ParentStudentLink {
  id                 String    @id @default(cuid())
  parentId           String
  studentId          String
  createdByTeacherId String
  invitationId       String    @unique
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?

  parent           User             @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student          User             @relation("ChildLinks", fields: [studentId], references: [id], onDelete: Cascade)
  createdByTeacher User             @relation("IssuedParentLinks", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  invitation      ParentInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}
